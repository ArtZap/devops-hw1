<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><title>nginx by Terraform</title></head>
<body>
<h1>Hello from Terraform</h1>
<p>nginx container created by the kreuzwerker/docker provider.</p>
<ul>
  <li>network: ${network} (${subnet})</li>
  <li>volume: ${volume} mounted at /usr/share/nginx/html</li>
  <li>host port: ${port} -> container port 80</li>
</ul>
</body>
</html>
